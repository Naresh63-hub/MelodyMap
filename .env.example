# ── MelodyMap — environment variables ──────────────────────────
# Copy this file to .env and fill in real values. NEVER commit .env.

# ── AI recommendations (optional) ──────────────────────────────────
# Any OpenAI-compatible API key (OpenAI, Groq, Together, etc.)
AI_API_KEY=
# Base URL of the API (defaults to https://api.openai.com/v1 if not set)
# AI_API_BASE_URL=

# ── Supabase (auth + account sync) ──────────────────────────────────
# From your Supabase project → Project Settings → API.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Vite exposes these to the browser (publishable key only, never the
# service role key).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
