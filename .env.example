# ==============================================================================
# MelodyMap Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` or `.env.local` for local development.
# In production, set these variables in your hosting provider (e.g. Vercel Dashboard).
#
# IMPORTANT SECURITY RULES:
# 1. NEVER commit `.env`, `.env.local`, or any actual API keys to source control.
# 2. Only variables prefixed with `VITE_` are exposed to the browser.
# 3. Server-only secrets (without `VITE_`) MUST NOT have a `VITE_` equivalent.
# 4. For GitHub Actions CI/CD, store private credentials under Repository Secrets.
# ==============================================================================

# ─── Client-Side: Supabase Authentication & Sync (Optional) ──────────────────
# Required only for multi-device account sync. When unset, MelodyMap runs in
# offline-first / local storage guest mode.
# In Supabase Dashboard: Project Settings -> API.
# Note: Publishable / Anon keys are public client keys protected by Row Level Security (RLS).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── Optional: Native Android 1-Tap Google Sign-In ────────────────────────────
# OAuth 2.0 Web Client ID from Google Cloud Console / Supabase Dashboard -> Auth -> Google.
# Enables native Play Services account picker directly in the Android APK.
VITE_GOOGLE_CLIENT_ID=

# ─── Server-Side Only: AI Recommendation Engine (Optional) ───────────────────
# Used for server-side semantic playlist generation and intelligent fallback mixes.
# Any OpenAI-compatible gateway (OpenAI, Groq, OpenRouter, Together, etc.).
# Defaults to https://api.openai.com/v1 when unset.
# NEVER prefix these with VITE_ to prevent client-side exposure.
AI_API_BASE_URL=
AI_API_KEY=
# Model ID to request (e.g., "gpt-4o-mini", "google/gemini-2.0-flash", etc.)
AI_MODEL=

# ─── Server-Side Only: Optional YouTube Data API v3 (Optional) ───────────────
# MelodyMap uses multi-provider open discovery (Audius, Jamendo, Deezer, Archive)
# and zero-auth YouTube streaming adapters by default.
# If you optionally configure a Google Cloud API key for YouTube Data API v3:
#
# RESTRICTION GUIDELINES (Google Cloud Console):
# 1. API Restrictions: Restrict key exclusively to "YouTube Data API v3".
# 2. Application Restrictions:
#    - If called from backend: Restrict by IP address or keep strictly server-side (no VITE_ prefix).
#    - If called from browser: Restrict by HTTP referrers:
#        https://your-domain.vercel.app/*
#        https://*.vercel.app/*
#        http://localhost:*/*
# 3. Quotas: Set daily request quotas to prevent unexpected billing.
#
YOUTUBE_API_KEY=
