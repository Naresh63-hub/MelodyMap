<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Production network security configuration: disallow cleartext HTTP traffic -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Explicitly secure domain for MelodyMap backend on Vercel -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">melodymap-pi.vercel.app</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
