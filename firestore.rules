rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Health check test connection path for startup verification
    match /test/connection {
      allow read: if true;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;

      function isValidUser(data) {
        return data.keys().hasAll(['id']) &&
               data.keys().hasOnly(['id', 'email', 'displayName', 'photoURL', 'createdAt', 'updatedAt']) &&
               data.id == request.auth.uid &&
               (data.id is string && data.id.size() <= 128) &&
               (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() <= 100)) &&
               (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 1000)) &&
               (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 200));
      }

      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(request.resource.data) &&
                       request.resource.data.id == resource.data.id;
      allow delete: if isOwner(userId) && isValidId(userId);

      // User Likes (Favourites)
      match /likes/{trackId} {
        allow get: if isOwner(userId) && isValidId(trackId);
        allow list: if isOwner(userId);

        function isValidLikedTrack(data) {
          return data.keys().hasAll(['id', 'userId', 'title', 'artist']) &&
                 data.keys().hasOnly(['id', 'userId', 'title', 'artist', 'thumbnail', 'duration', 'previewUrl', 'addedAt']) &&
                 data.userId == request.auth.uid &&
                 data.id is string && data.id.size() <= 128 &&
                 data.title is string && data.title.size() <= 300 &&
                 data.artist is string && data.artist.size() <= 300;
        }

        allow create: if isOwner(userId) && isValidId(userId) && isValidId(trackId) &&
                         isValidLikedTrack(request.resource.data);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(trackId) &&
                         isValidLikedTrack(request.resource.data) &&
                         request.resource.data.id == resource.data.id &&
                         request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(trackId);
      }

      // User Playlists
      match /playlists/{playlistId} {
        allow get: if isOwner(userId) && isValidId(playlistId);
        allow list: if isOwner(userId);

        function isValidPlaylist(data) {
          return data.keys().hasAll(['id', 'userId', 'name']) &&
                 data.keys().hasOnly(['id', 'userId', 'name', 'description', 'tracks', 'createdAt', 'updatedAt']) &&
                 data.userId == request.auth.uid &&
                 data.id is string && data.id.size() <= 128 &&
                 data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
                 (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 500)) &&
                 (!('tracks' in data) || (data.tracks is list && data.tracks.size() <= 500));
        }

        allow create: if isOwner(userId) && isValidId(userId) && isValidId(playlistId) &&
                         isValidPlaylist(request.resource.data);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(playlistId) &&
                         isValidPlaylist(request.resource.data) &&
                         request.resource.data.id == resource.data.id &&
                         request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(playlistId);
      }

      // Listening History
      match /history/{historyId} {
        allow get: if isOwner(userId) && isValidId(historyId);
        allow list: if isOwner(userId);

        function isValidHistoryItem(data) {
          return data.keys().hasAll(['id', 'userId', 'trackId', 'title', 'artist']) &&
                 data.keys().hasOnly(['id', 'userId', 'trackId', 'title', 'artist', 'thumbnail', 'playedAt']) &&
                 data.userId == request.auth.uid &&
                 data.id is string && data.id.size() <= 128 &&
                 data.trackId is string && data.trackId.size() <= 128 &&
                 data.title is string && data.title.size() <= 300 &&
                 data.artist is string && data.artist.size() <= 300;
        }

        allow create: if isOwner(userId) && isValidId(userId) && isValidId(historyId) &&
                         isValidHistoryItem(request.resource.data);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(historyId) &&
                         isValidHistoryItem(request.resource.data) &&
                         request.resource.data.id == resource.data.id &&
                         request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(historyId);
      }

      // User Settings / Preferences
      match /settings/preferences {
        allow get: if isOwner(userId);
        allow list: if false;

        function isValidSettings(data) {
          return data.keys().hasAll(['userId']) &&
                 data.keys().hasOnly(['userId', 'languages', 'audioQuality', 'crossfade', 'continuous', 'volume', 'updatedAt']) &&
                 data.userId == request.auth.uid &&
                 (!('languages' in data) || (data.languages is list && data.languages.size() <= 30)) &&
                 (!('audioQuality' in data) || (data.audioQuality is string && data.audioQuality.size() <= 20)) &&
                 (!('crossfade' in data) || (data.crossfade is number && data.crossfade >= 0 && data.crossfade <= 15)) &&
                 (!('continuous' in data) || data.continuous is bool) &&
                 (!('volume' in data) || (data.volume is number && data.volume >= 0 && data.volume <= 100));
        }

        allow create: if isOwner(userId) && isValidId(userId) && isValidSettings(request.resource.data);
        allow update: if isOwner(userId) && isValidId(userId) && isValidSettings(request.resource.data) &&
                         request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId) && isValidId(userId);
      }

      // User Library Data Sync
      match /library/{docId} {
        allow get: if isOwner(userId) && isValidId(docId);
        allow list: if isOwner(userId);
        allow create, update, delete: if isOwner(userId) && isValidId(docId);
      }
    }
  }
}
